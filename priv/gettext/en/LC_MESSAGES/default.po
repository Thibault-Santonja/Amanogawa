msgid "Supprimer mon compte"
msgstr "Delete my account"

#: lib/amanogawa_web/live/login_live.ex:81
#, elixir-autogen, elixir-format
msgid "Trop de demandes, réessayez dans quelques minutes."
msgstr "Too many requests, try again in a few minutes."

#: lib/amanogawa_web/live/account_live.ex:184
#, elixir-autogen, elixir-format
msgid "Télécharger mes données (JSON)"
msgstr "Download my data (JSON)"

#: lib/amanogawa_web/controllers/page_html/privacy.html.heex:33
#, elixir-autogen, elixir-format
msgid "Un visiteur qui se connecte reçoit en complément un second cookie, de session authentifiée (HttpOnly, SameSite=Lax, Secure) : voir la section \"Comptes utilisateurs\" ci-dessous."
msgstr "A visitor who signs in also receives a second cookie, an authenticated session cookie (HttpOnly, SameSite=Lax, Secure): see the \"User accounts\" section below."

#: lib/amanogawa_web/live/account_live.ex:182
#, elixir-autogen, elixir-format
msgid "Vos données"
msgstr "Your data"

#: lib/amanogawa_web/controllers/page_html/privacy.html.heex:56
#, elixir-autogen, elixir-format
msgid "Vos droits : depuis la page \"Mon compte\", vous exportez l'intégralité de vos données (format JSON) et vous supprimez votre compte, immédiatement et sans délai, en autonomie complète. Pour toute autre demande, voir la section Contact ci-dessous."
msgstr "Your rights: from the \"My account\" page, you export the entirety of your data (JSON format) and delete your account, immediately and without delay, in complete autonomy. For any other request, see the Contact section below."

#: lib/amanogawa_web/live/account_live.ex:119
#, elixir-autogen, elixir-format
msgid "Votre compte a été supprimé."
msgstr "Your account has been deleted."

#: lib/amanogawa_web/live/account_live.ex:140
#, elixir-autogen, elixir-format
msgid "Vous avez été déconnecté."
msgstr "You have been signed out."

#: lib/amanogawa_web/controllers/session_controller.ex:56
#, elixir-autogen, elixir-format
msgid "Vous êtes déconnecté."
msgstr "You are signed out."

#: lib/amanogawa_web/live/login_live.ex:106
#, elixir-autogen, elixir-format
msgid "Vérifiez votre boîte mail : si cette adresse est associée à un compte (ou peut en créer un), un lien de connexion valable 15 minutes vient de vous être envoyé."
msgstr "Check your inbox: if this address is associated with an account (or can create one), a sign-in link valid for 15 minutes has just been sent to you."
